<a class="skip" href="#main">本文へスキップ</a>
<div class="masthead">
  <a class="masthead__logo" href="/" aria-label="MODIGI ホーム"><span class="logo-mark logo--gold" aria-hidden="true"></span></a>
  <p class="masthead__tag">Handcrafted Leather · Since {{ site.founded }}</p>
</div>
<header class="navbar" data-header>
  <div class="navbar__inner">
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="drawer" data-menu-btn>
      <span class="menu-btn__bars" aria-hidden="true"></span><span class="sr">メニュー</span>
    </button>
    <a class="navbar__mini" href="/" aria-label="MODIGI ホーム"><span class="logo-mark logo--gold" aria-hidden="true"></span></a>
    <nav class="navbar__nav" aria-label="メインメニュー">
      <a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a>
      {%- for l in lines %}
      <a href="/collection/{{ l.slug }}/"{% if page.url == '/collection/' + l.slug + '/' %} aria-current="page"{% endif %}>{{ l.en }}</a>
      {%- endfor %}
      <a href="/story/"{% if page.url.startsWith('/story/') %} aria-current="page"{% endif %}>About Us</a>
      <a href="/contact/"{% if page.url.startsWith('/contact/') %} aria-current="page"{% endif %}>Contact</a>
    </nav>
    <a class="btn btn--gold btn--small navbar__cta" href="{{ site.amazon }}" target="_blank" rel="noopener" data-amazon="header">Amazonで購入</a>
  </div>
</header>
<div class="drawer" id="drawer" hidden data-drawer>
  <nav aria-label="モバイルメニュー">
    <ul>
      <li><a href="/">ホーム<span>Home</span></a></li>
      <li><a href="/collection/">コレクション<span>Collection</span></a></li>
      {%- for l in lines %}<li><a href="/collection/{{ l.slug }}/">{{ l.ja }}<span>{{ l.en }}</span></a></li>{% endfor %}
      <li><a href="/materials/">素材とお手入れ<span>Materials</span></a></li>
      <li><a href="/story/">ブランドストーリー<span>About Us</span></a></li>
      <li><a href="/journal/">ジャーナル<span>Journal</span></a></li>
      <li><a href="/guide/">サイズガイド<span>Size Guide</span></a></li>
      <li><a href="/faq/">よくあるご質問<span>FAQ</span></a></li>
      <li><a href="/contact/">お問い合わせ<span>Contact</span></a></li>
    </ul>
    <a class="btn btn--gold btn--block" href="{{ site.amazon }}" target="_blank" rel="noopener" data-amazon="drawer">Amazon公式ストアで購入</a>
  </nav>
</div>
