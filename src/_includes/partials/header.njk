<a class="skip" href="#main">本文へスキップ</a>
<header class="site-header{% if transparentHeader %} is-over-hero{% endif %}" data-header>
  <div class="site-header__inner">
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="drawer" data-menu-btn>
      <span class="menu-btn__bars" aria-hidden="true"></span><span class="sr">メニュー</span>
    </button>
    <nav class="nav nav--primary" aria-label="メインメニュー">
      <a href="/collection/"{% if page.url.startsWith('/collection/') %} aria-current="page"{% endif %}>コレクション</a>
      <a href="/materials/"{% if page.url.startsWith('/materials/') %} aria-current="page"{% endif %}>素材</a>
    </nav>
    <a class="brand" href="/" aria-label="MODIGI ホーム"><span class="logo-mark" aria-hidden="true"></span></a>
    <nav class="nav nav--secondary" aria-label="サブメニュー">
      <a href="/story/"{% if page.url.startsWith('/story/') %} aria-current="page"{% endif %}>ストーリー</a>
      <a href="/journal/"{% if page.url.startsWith('/journal/') %} aria-current="page"{% endif %}>ジャーナル</a>
    </nav>
    <a class="btn btn--small header-cta" href="{{ site.amazon }}" target="_blank" rel="noopener" data-amazon="header">Amazonで購入</a>
  </div>
</header>
<div class="drawer" id="drawer" hidden data-drawer>
  <nav aria-label="モバイルメニュー">
    <ul>
      <li><a href="/">ホーム<span>Home</span></a></li>
      {% for i in site.nav %}<li><a href="{{ i.href }}">{{ i.ja }}<span>{{ i.en }}</span></a></li>{% endfor %}
      <li><a href="/faq/">よくあるご質問<span>FAQ</span></a></li>
      <li><a href="/contact/">お問い合わせ<span>Contact</span></a></li>
    </ul>
    <a class="btn btn--block" href="{{ site.amazon }}" target="_blank" rel="noopener" data-amazon="drawer">Amazon公式ストアで購入</a>
  </nav>
</div>
