<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__about">
        <a href="/" aria-label="MODIGI ホーム"><span class="logo-mark logo--gold" aria-hidden="true"></span></a>
        <span class="logo-slogan logo--gold" role="img" aria-label="Make Your Style"></span>
      </div>
      <nav aria-label="フッター：製品">
        <h2 class="site-footer__h">Collection</h2>
        <ul>{% for l in lines %}<li><a href="/collection/{{ l.slug }}/">{{ l.ja }}</a></li>{% endfor %}</ul>
      </nav>
      <nav aria-label="フッター：ブランド">
        <h2 class="site-footer__h">Maison</h2>
        <ul>
          <li><a href="/story/">ブランドストーリー</a></li>
          <li><a href="/materials/">素材とお手入れ</a></li>
          <li><a href="/journal/">ジャーナル</a></li>
        </ul>
      </nav>
      <nav aria-label="フッター：サポート">
        <h2 class="site-footer__h">Support</h2>
        <ul>
          <li><a href="/guide/">サイズガイド</a></li>
          <li><a href="/faq/">よくあるご質問</a></li>
          <li><a href="/contact/">お問い合わせ</a></li>
          <li><a href="/privacy/">プライバシーポリシー</a></li>
        </ul>
      </nav>
    </div>
    <div class="site-footer__bar">
      <a class="site-footer__mini" href="/" aria-label="MODIGI ホーム"><span class="logo-mark logo--gold" aria-hidden="true"></span></a>
      <p class="site-footer__tagline">Quality. Craftsmanship. Heritage.</p>
      <div class="site-footer__social">
        <a href="{{ site.amazon }}" target="_blank" rel="noopener" aria-label="Amazon公式ストア"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 15.5c4.5 3 11.5 3 16 0M17 14.5l3 1-1 3" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 11.5c0-2.2 1.8-3.5 4-3.5s4 1 4 3v4" stroke-linecap="round"/></svg></a>
        <a href="mailto:{{ site.email }}" aria-label="メール"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5" stroke-linejoin="round"/></svg></a>
        <a href="/contact/" aria-label="お問い合わせ"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v10H9l-4 4z" stroke-linejoin="round"/></svg></a>
      </div>
    </div>
    <div class="site-footer__base">
      <small>&copy; {{ site.founded }}–{% year %} MODIGI. All rights reserved.</small>
      <small>Apple Watchは、米国およびその他の国で登録されたApple Inc.の商標です。</small>
    </div>
  </div>
</footer>
