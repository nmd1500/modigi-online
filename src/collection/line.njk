---
layout: layouts/base.njk
pagination:
  data: lines
  size: 1
  alias: line
  addAllPagesToCollections: true
permalink: "/collection/{{ line.slug }}/"
eleventyComputed:
  title: "{{ line.ja }}（{{ line.en }}）Apple Watch 本革バンド"
  description: "{{ line.lead }} MODIGIの{{ line.ja }} Apple Watchバンドは、職人による手縫い仕上げ。38〜49mmの全サイズに対応。"
  ogImage: "{{ line.hero }}"
---
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "ProductGroup",
  "name": "MODIGI " + line.en + " Apple Watch レザーバンド",
  "description": line.lead,
  "brand": { "@type": "Brand", "name": "MODIGI" },
  "image": site.url + "/assets/img/" + line.hero + "-1200.webp",
  "url": site.url + page.url,
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "JPY",
    "lowPrice": line.minPrice,
    "highPrice": line.maxPrice,
    "offerCount": line.count,
    "url": site.amazon
  }
} | json | safe }}</script>

<section class="page-hero" style="padding-bottom:clamp(32px,4vw,56px)">
  <div class="container">
    <ol class="breadcrumb"><li><a href="/">ホーム</a></li><li><a href="/collection/">コレクション</a></li><li>{{ line.ja }}</li></ol>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container pdp">
    <div class="pdp__media">
      <figure>{% img line.hero, line.ja + "のApple Watchレザーバンド", "(min-width: 960px) 55vw, 100vw", "eager" %}</figure>
      {%- if line.gallery.length %}
      <div class="pdp__thumbs">
        {%- for g in line.gallery %}<figure class="reveal-img">{% img g, line.ja + "のレザーバンド ディテール", "(min-width: 960px) 27vw, 50vw" %}</figure>{% endfor %}
      </div>
      {%- endif %}
    </div>
    <div class="pdp__info">
      <p class="eyebrow">{{ line.kana }}</p>
      <h1 class="pdp__title">{{ line.en }}</h1>
      <p class="row__ja" style="margin-bottom:0">{{ line.ja }}</p>
      {% if line.minPrice %}
      <p class="pdp__price">{{ line.minPrice | yen }}{% if line.maxPrice > line.minPrice %} – {{ line.maxPrice | yen }}{% endif %}<small>税込・参考価格</small></p>
      <p class="pdp__note">全{{ line.count }}モデル。最新の価格・在庫はAmazon公式ストアでご確認ください。</p>
      {% endif %}
      <p class="lead" style="margin-top:28px">{{ line.lead }}</p>

      <dl class="spec">
        {%- for s in line.specs %}<div><dt>{{ s[0] }}</dt><dd>{{ s[1] }}</dd></div>{% endfor %}
        {%- if line.sizes.length %}<div><dt>対応サイズ</dt><dd><div class="chips">{% for s in line.sizes %}<span class="chip">{{ s }}</span>{% endfor %}</div></dd></div>{% endif %}
        {%- if line.colors.length %}<div><dt>カラー</dt><dd><div class="chips">{% for c in line.colors %}<span class="chip"><i style="background:{{ swatches[c] }}"></i>{{ c }}</span>{% endfor %}</div></dd></div>{% endif %}
        <div><dt>対応モデル</dt><dd>Series 4〜11 / SE / Ultra 1〜3</dd></div>
      </dl>

      <a class="btn btn--block" href="{{ site.amazon }}" target="_blank" rel="noopener" data-amazon="line-{{ line.slug }}">Amazonで購入する</a>
      <p style="margin-top:16px;text-align:center"><a class="link-arrow" href="/guide/">サイズの選び方</a></p>

      <ul class="assurances">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16M12 4v16" stroke-linecap="round"/><circle cx="12" cy="12" r="9"/></svg>職人による一本ずつの手縫い仕上げ</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8" width="18" height="12" rx="1"/><path d="M3 12h18M12 8v12M8 8c-2-3 2-5 4 0 2-5 6-3 4 0"/></svg>オリジナルギフトボックス入り</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5 10 17l9-10" stroke-linecap="round" stroke-linejoin="round"/></svg>工具不要・ワンタッチで付け替え</li>
      </ul>
    </div>
  </div>
</section>

<section class="section section--paper">
  <div class="container split">
    <div>
      <p class="eyebrow reveal">About the leather</p>
      <h2 class="h2 reveal">{{ line.ja }}という選択。</h2>
      {% for p in line.body %}<p class="lead reveal" style="margin-top:24px">{{ p }}</p>{% endfor %}
      <div class="btn-row reveal"><a class="btn btn--ghost" href="/materials/">素材とお手入れ</a></div>
    </div>
    <div class="split__media split__media--square reveal-img">{% img "craft-stitch", "職人による手縫いの工程", "(min-width: 960px) 50vw, 100vw" %}</div>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    <div class="section-head reveal"><div><p class="eyebrow">Other Collections</p><h2 class="h2">ほかのコレクション</h2></div></div>
    <div class="posts">
      {%- for l in lines %}{% if l.slug != line.slug %}
      <a class="post-card reveal" href="/collection/{{ l.slug }}/">
        <div class="post-card__media">{% img l.hero, l.ja + "のApple Watchレザーバンド", "(min-width: 960px) 33vw, 100vw" %}</div>
        <h3 class="line-card__en">{{ l.en }}</h3>
        <p>{{ l.ja }}{% if l.minPrice %} — {{ l.minPrice | yen }}〜{% endif %}</p>
      </a>
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>
{% include "partials/cta.njk" %}
